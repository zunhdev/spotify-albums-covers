{
  "name": "spotify_covers",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "format": "oxfmt --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \".zed/**/*.json\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \".zed/**/*.json\"",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "taze:check": "taze major --include-locked",
    "taze:upgrade:all": "taze major --write --include-locked",
    "taze:upgrade:safe": "taze --write"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "envalid": "9.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "taze": "21.3.0",
    "typescript": "7.0.2"
  }
}
